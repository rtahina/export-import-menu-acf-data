#. Plugin Name of the plugin
#: main.php
msgid "Export / Import ACF Menu Data"
msgstr "Export / Import ACF Menu Data"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: main.php
msgid "https://tahina.dev/"
msgstr "https://tahina.dev/"

#. Description of the plugin
#: main.php
msgid ""
"Exports and Imports the ACF data of a specific navigation menu. This plugin "
"requires ACF or ACF Pro plugin to be installed and active."
msgstr ""
"Exporte et importe les données ACF d'un menu de navigation spécifique. Ce "
"plugin nécessite l'installation et l'activation du plugin ACF ou ACF Pro."

#. Author of the plugin
#: main.php
msgid "Tahina R."
msgstr "Tahina R."

#: src/Admin/settings-page.php:18
msgid "Please choose a menu in the dropdown list."
msgstr "Veuillez choisir un menu dans la liste déroulante."

#: src/ExportImportMenuAcfData.php:67
msgid "You are not allowed to submit this form."
msgstr "Vous n'êtes pas autorisé à soumettre ce formulaire."

#: src/ExportImportMenuAcfData.php:72
msgid "You don't have the right to execute this action."
msgstr "Vous n'avez pas le droit d'effectuer cette action."

#: src/Services/MenuService.php:130
msgid "Please, choose a file to import."
msgstr "Veuillez choisir un fichier à importer."

#: src/Services/MenuService.php:144
msgid "This file type is not allowed. Please choose a JSON file to import."
msgstr ""
"Ce type de fichier n'est pas autorisé. Veuillez choisir un fichier JSON à "
"importer."

#: src/Services/MenuService.php:155
#, php-format
msgid "Invalid JSON data: %s"
msgstr "Données JSON invalides : %s"

#: src/Services/MenuService.php:163
msgid "Invalid JSON format"
msgstr "Format JSON invalide"

#: src/Services/MenuService.php:173
#, php-format
msgid ""
"The menu \"%s\" already exists. Please, choose another name or allow "
"override."
msgstr ""
"Le menu \"%s\" existe déjà. Veuillez choisir un autre nom ou autoriser le "
"remplacement."

#: src/Services/MenuService.php:183
msgid "There was a problem deleting the menu"
msgstr "Un problème est survenu lors de la suppression du menu."

#: src/Services/MenuService.php:248
#, php-format
msgid "There was an error creating \"%s\" menu item."
msgstr ""
"Une erreur s'est produite lors de la création de l'élément de menu \"%s\"."

#: src/Services/MenuService.php:290
#, php-format
msgid "%d navigation menu items successfully imported."
msgstr "%d éléments du menu de navigation ont été importés avec succès."
